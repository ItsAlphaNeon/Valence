{
  "name": "valence",
  "productName": "Valence",
  "version": "0.1.0",
  "description": "Personal music library manager and player",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Valence",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "gen-test-audio": "node scripts/gen-test-audio.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run fetch-binaries && npm run build && electron-builder --mac",
    "dist:linux": "npm run fetch-binaries && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "fast-xml-parser": "^5.11.2",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.3.4",
    "node-taglib-sharp": "^6.0.3",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.25",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true,
    "electron@45.2.1": true,
    "better-sqlite3": false
  }
}
